# Settings for docker-compose.yml. Copy to .env in the same directory and fill
# in; Compose reads .env by itself. Nothing here is a real value.
#
# What each application setting means is written out in apps/web/.env.example.
# DATABASE_URL is not set here: the compose file builds it from
# POSTGRES_PASSWORD and points it at the database container.

# --- Required -----------------------------------------------------------

# Password of the Postgres user "holdfast". It goes into a connection URL as
# it is, so use letters and digits only:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The 32-byte key that viewing keys and service keys are encrypted under at
# rest, as 64 hex characters. Losing it loses every stored key; back it up
# apart from the database.
#   openssl rand -hex 32
HOLDFAST_MASTER_KEY=

# Bearer token the scheduler presents to POST /api/tick. At least 32 characters.
#   openssl rand -hex 32
TICK_SECRET=

# Signs the session cookie. At least 32 characters. Changing it signs everyone out.
#   openssl rand -hex 32
SESSION_SECRET=

# The host browsers reach the application on, with the port if it has one and
# nothing else: "holdfast.example" behind a proxy, "localhost:3000" for a
# trial on this machine. Sign-in messages must be written for it and every
# state-changing request must come from it.
HOLDFAST_PUBLIC_HOST=localhost:3000

# "mainnet" or "testnet": the Zcash chain the treasuries are on and the
# Hyperliquid the hedges are on.
HOLDFAST_NETWORK=mainnet

# Private key (0x and 64 hex characters) of the account that pays the fees of
# Tempo payouts. Make a new one for this purpose and send its address fee
# tokens only; it holds nothing else and cannot move anyone's funds.
#   echo 0x$(openssl rand -hex 32)
TEMPO_SPONSOR_PRIVATE_KEY=

# --- Optional -----------------------------------------------------------

# Address and port the application is published on. The default is this
# machine only; put a TLS proxy in front before opening it to anyone else.
HOLDFAST_BIND=127.0.0.1
HOLDFAST_PORT=3000

# lightwalletd endpoints, comma separated, tried in order. On mainnet the
# public zec.rocks endpoints are used when this is empty; on testnet it is required.
ZCASH_ENDPOINTS=

# "mainnet" or "moderato". Follows HOLDFAST_NETWORK when empty.
TEMPO_NETWORK=
# RPC endpoint of that network; its public one when empty.
TEMPO_RPC_URL=
# TIP-20 stablecoin payouts are made in: USDC.e on mainnet and AlphaUSD on Moderato when empty.
TEMPO_TOKEN=

# "mainnet-beta" or "devnet". Follows HOLDFAST_NETWORK when empty.
SOLANA_CLUSTER=
# RPC endpoint of that cluster; its public one when empty.
SOLANA_RPC_URL=
# Mint payouts are made in, and its decimals: USDC with six when empty.
SOLANA_MINT=
SOLANA_MINT_DECIMALS=
# The slot from which every Solana payout of this deployment has set a run
# marker, and never an earlier one. Leave empty until that slot is known.
# docs/SELF-HOSTING.md says how to choose it and docs/THREAT-MODEL.md what it
# decides.
SOLANA_MARKERS_FROM=

# 1Click partner key; lowers the swap service's fee.
ONECLICK_API_KEY=

# Address of the HedgeAttestor contract on HyperEVM (chain 999). With it set,
# and HOLDFAST_NETWORK=mainnet, the tick records a snapshot of each
# organisation's hedge and journal root there, for every organisation whose
# owner has named its attester key on the contract. Empty switches
# attestations off; so does any network but mainnet.
HEDGE_ATTESTOR_ADDRESS=
# RPC endpoint of HyperEVM mainnet; the public one when empty.
HYPEREVM_RPC_URL=
# The least time between two snapshots of one organisation, in whole minutes.
# 60 when empty; at least 5.
ATTEST_EVERY_MINUTES=
