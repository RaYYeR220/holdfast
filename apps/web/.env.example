# Settings of the Holdfast web application. Copy to .env.local and fill in.
# Each one is read and checked the first time something needs it; a missing
# or malformed value fails that request with a message naming the variable.

# --- Required -----------------------------------------------------------

# Postgres connection string. In production this is the Supabase transaction
# pooler (port 6543); the store never relies on session state.
DATABASE_URL=

# The 32-byte key that viewing keys and service keys are encrypted under at
# rest, as 64 hex characters or as base64. Losing it loses every stored key.
HOLDFAST_MASTER_KEY=

# Bearer token the scheduler presents to POST /api/tick. At least 32 characters.
TICK_SECRET=

# Signs the session cookie. At least 32 characters. Changing it signs everyone out.
SESSION_SECRET=

# The host the application is served on, as browsers name it: "holdfast.example"
# or "localhost:3000". Sign-in messages must be written for it and every
# state-changing request must come from it. Required in production; without it
# a development server takes the host each request names.
HOLDFAST_PUBLIC_HOST=

# "mainnet" or "testnet": the Zcash chain the treasuries are on and the
# Hyperliquid the hedges are on. It also picks the defaults further down.
HOLDFAST_NETWORK=

# Private key (0x and 64 hex characters) of the account that pays the fees of
# Tempo payouts. It holds fee tokens only and cannot move anyone's funds.
TEMPO_SPONSOR_PRIVATE_KEY=

# --- Optional -----------------------------------------------------------

# lightwalletd endpoints, comma separated, tried in order. On mainnet the
# public zec.rocks endpoints are used when this is empty; on testnet it is required.
ZCASH_ENDPOINTS=

# "mainnet" or "moderato". Follows HOLDFAST_NETWORK when empty.
TEMPO_NETWORK=
# RPC endpoint of that network; its public one when empty.
TEMPO_RPC_URL=
# TIP-20 stablecoin payouts are made in: USDC.e on mainnet and AlphaUSD on Moderato when empty.
TEMPO_TOKEN=

# "mainnet-beta" or "devnet". Follows HOLDFAST_NETWORK when empty.
SOLANA_CLUSTER=
# RPC endpoint of that cluster; its public one when empty.
SOLANA_RPC_URL=
# Mint payouts are made in, and its decimals: USDC with six when empty.
SOLANA_MINT=
SOLANA_MINT_DECIMALS=
# The slot from which every Solana payout of this deployment has set a run
# marker: a slot taken once no build that pays without markers was running
# any more, and never an earlier one. A run created at or after it is sent on
# a missing marker alone; an older one only once the account's history proves
# it unpaid. Leave empty until that slot is known.
SOLANA_MARKERS_FROM=

# 1Click partner key; lowers the swap service's fee.
ONECLICK_API_KEY=
